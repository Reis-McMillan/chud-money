# HTTP server
BIND_ADDR=0.0.0.0:3000
# Base used to build the proxy websocket URLs stored in each market document.
PUBLIC_WS_BASE=ws://localhost:3000

# MongoDB (model store)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=chud

# QuestDB (timeseries). ILP conf string is passed verbatim to questdb-rs.
QUESTDB_ILP_CONF=http::addr=localhost:9000;
QUESTDB_PG_HOST=localhost
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=quest
QUESTDB_PG_DB=qdb

# Verys. The SPA logs in and exchanges its session for a token scoped to this
# API (audience = CHUD_MONEY_API_CLIENT_ID); this API only verifies those
# tokens against the Verys signing key, so no client secret is needed.
AUTH_URL=http://localhost:8081
# Expected `iss` of access tokens. Only set it when it differs from AUTH_URL
# (the Verys dev config issues for http://localhost:8080).
# VERYS_ISSUER=http://localhost:8080
# This API's Verys client id; also the expected `aud` claim. The SPA's
# VITE_CHUD_MONEY_CLIENT_ID must hold the same value.
CHUD_MONEY_API_CLIENT_ID=

# Kalshi. The demo environment has no KXBTC15M or CF Benchmarks data; use prod.
KALSHI_ENV=prod
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=kalshi_key.pem

# Coinbase (CDP) API key for ingesting spot candles; optional, but
# both are needed. The secret is the key's base64 Ed25519 private key; requests are
# signed as EdDSA JWTs.
# CDP_API_KEY_ID=00000000-0000-0000-0000-000000000000
# CDP_API_KEY_SECRET=

# docker compose only: host path of the RSA private key mounted into the api
# container as /run/secrets/kalshi_key (the MONGO_*/QUESTDB_* hosts above are
# overridden with service names by docker-compose.yaml).
# KALSHI_PRIVATE_KEY_FILE=~/.ssh/id_kalshi

RUST_LOG=info,chud_money=debug
